# npm run dev: the fake API and fake Reverb run inside the Vite dev server.
# Leaving REVERB host/port empty means "same host and port as the page".
VITE_REVERB_APP_KEY=cloudjoi-dev
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=http

# Fake API knobs (not exposed to the browser):
# MOCK_BOTS=off      no simulated buyers
# MOCK_LATENCY=0     no artificial response delay (default: up to 250 ms)
