{
  "name": "cloudjoi-seat-selection",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:types": "openapi-typescript api/openapi.yaml -o src/api/schema.d.ts",
    "local": "vite --mode backend",
    "test": "vitest run",
    "seatmap": "node scripts/generate-seatmap.ts"
  },
  "dependencies": {
    "laravel-echo": "^2.5.0",
    "openapi-fetch": "^0.17.0",
    "pusher-js": "^8.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-qrcode": "^0.4.1",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
